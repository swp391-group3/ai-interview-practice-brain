  "cards": [
    {
      "dot": "emerald",
      "title": "Reviewed JD & Configuration",
      "items": [
        "PDF text extraction is decoupled from LLM parsing to keep file parsing testable and modular",
        "Candidate review provides human-in-the-loop authority over extracted skills before planning",
        "Interview configuration supplies difficulty, duration, and question budget independent of JD seniority"
      ]
    },
    {
      "dot": "rose",
      "title": "Semantic Planning & Contract Gate",
      "items": [
        "LLM acts as a semantic planner, proposing an assessment agenda rather than fixed question wording",
        "Deterministic validator normalizes stages, question budgets, and scoring rubrics before storage",
        "Untrusted LLM proposals are rejected if invalid; existing valid blueprints are never destroyed"
      ]
    },
    {
      "dot": "orange",
      "title": "Immutable Contract vs. Runtime",
      "items": [
        "Interview Blueprint defines WHAT to assess (competencies, allocated minutes, question budgets)",
        "Adaptive Interview Runtime defines HOW to ask (generating contextual questions during turns)",
        "Session blueprint snapshot freezes the assessment plan for tamper-proof evaluation reproducibility"
      ]
    }
  ]
