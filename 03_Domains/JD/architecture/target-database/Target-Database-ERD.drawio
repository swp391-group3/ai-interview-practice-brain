        </mxCell>
        <mxCell id="banner_title" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;KAN-46 TARGET DATABASE SCHEMA (PROPOSED ARCHITECTURE)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 12px; color: #4527a0;&quot;&gt;Governance Level: Local Working Contract (Pending Backend Team Ratification) • Basis: PR #7 baseline + KAN-46 Business Rules (BR-01 to BR-13)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="banner">
          <mxGeometry x="10" y="10" width="1800" height="46" as="geometry" />
        </mxCell>
        <mxCell id="badge_kan46" value="&lt;b&gt;PROPOSAL: KAN-46 TARGET&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#512da8;fontColor=#311b92;fontSize=12;align=center;" vertex="1" parent="banner">
          <mxGeometry x="20" y="66" width="240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="badge_status" value="&lt;b&gt;STATUS: LOCAL WORKING CONTRACT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;fontColor=#e65100;fontSize=12;align=center;" vertex="1" parent="banner">
          <mxGeometry x="280" y="66" width="290" height="34" as="geometry" />
        </mxCell>
        <mxCell id="badge_gov" value="&lt;b&gt;GOVERNANCE: PENDING TEAM RATIFICATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontColor=#b71c1c;fontSize=12;align=center;" vertex="1" parent="banner">
          <mxGeometry x="590" y="66" width="340" height="34" as="geometry" />
        </mxCell>
        <mxCell id="badge_source" value="&lt;b&gt;PR #7 EXTENSION (NOT MERGED YET)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#212121;strokeColor=#000000;fontColor=#ffffff;fontSize=12;align=center;" vertex="1" parent="banner">
          <mxGeometry x="950" y="66" width="300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="banner_notice" value="&lt;font style=&quot;font-size: 11px; color: #37474f;&quot;&gt;&lt;b&gt;CORE LIFECYCLE CHANGES:&lt;/b&gt; (1) Extracted 1:N &lt;i&gt;interview_blueprints&lt;/i&gt; from JD blob. (2) Re-parented Session → Blueprint (1:N) with immutable &lt;i&gt;blueprint_snapshot&lt;/i&gt;. (3) Normalized redundant session columns (jd_id, difficulty, duration, questions).&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="banner">
          <mxGeometry x="10" y="110" width="1800" height="28" as="geometry" />
        </mxCell>
        <!-- POSTGRESQL ENUMS: GROUP 1 (ACCOUNTS & JD) -->
        <mxCell id="enums_group1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="510" y="220" width="410" height="220" as="geometry" />
        </mxCell>
        <mxCell id="enums_g1_title" value="&lt;b&gt;POSTGRESQL ENUMS: AUTH &amp;amp; JD DOMAINS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#adb5bd;fontColor=#212529;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="enums_group1">
          <mxGeometry x="0" y="0" width="410" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enums_g1_content" value="&lt;b&gt;1. account_role&lt;/b&gt; (accounts.role)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• &lt;font color=&quot;#1a73e8&quot;&gt;participant&lt;/font&gt; &lt;i style=&quot;color:#666;&quot;&gt;(DEFAULT)&lt;/i&gt;, jury, admin&lt;br/&gt;&lt;b&gt;2. seniority_level&lt;/b&gt; (job_descriptions.seniority_level)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• intern, junior, mid, senior, lead&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#555;&quot;&gt;(Independent from interview difficulty per BR-06)&lt;/i&gt;&lt;br/&gt;&lt;b&gt;3. jd_status&lt;/b&gt; (job_descriptions.status)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• &lt;font color=&quot;#1a73e8&quot;&gt;uploaded&lt;/font&gt; &lt;i style=&quot;color:#666;&quot;&gt;(DEFAULT)&lt;/i&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;• parsing, parsed, customized, locked, failed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="enums_group1">
          <mxGeometry x="0" y="32" width="410" height="180" as="geometry" />
        </mxCell>
        <!-- KAN-46 ARCHITECTURAL DECISIONS BOX -->
        <mxCell id="metadata_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="1040" width="380" height="340" as="geometry" />
        </mxCell>
        <mxCell id="meta_title" value="&lt;b&gt;KAN-46 ARCHITECTURAL DECISIONS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#b39ddb;fontColor=#311b92;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="metadata_box">
          <mxGeometry x="0" y="0" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="meta_content" value="&lt;b&gt;Lifecycle Invariants (BR-01 to BR-13):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;JD 1 → N Blueprints (BR-03):&lt;/b&gt; One reviewed JD can produce multiple assessment plans across difficulties.&lt;br/&gt;• &lt;b&gt;Blueprint 1 → N Sessions (BR-11):&lt;/b&gt; Saved plans are reusable across practice attempts.&lt;br/&gt;• &lt;b&gt;Immutable Snapshot (BR-12):&lt;/b&gt; &lt;i&gt;blueprint_snapshot jsonb&lt;/i&gt; preserved on session for historical fidelity.&lt;br/&gt;• &lt;b&gt;Normalization Decision:&lt;/b&gt; Redundant session fields (jd_id, difficulty, duration, question_count) normalized through &lt;i&gt;blueprint_id&lt;/i&gt;.&lt;br/&gt;&lt;b&gt;Governance Rule:&lt;/b&gt;&lt;br/&gt;• Working business rules confirmed locally for KAN-46.&lt;br/&gt;• Pending backend team review before database adoption." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="metadata_box">
          <mxGeometry x="0" y="32" width="380" height="300" as="geometry" />
        </mxCell>
        <!-- POSTGRESQL ENUMS & NOTATION LEGEND -->
        <mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1470" y="980" width="410" height="402" as="geometry" />
        </mxCell>
        <mxCell id="leg_title" value="&lt;b&gt;INTERVIEW ENUMS &amp;amp; ERD NOTATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#adb5bd;fontColor=#212529;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="legend_box">
          <mxGeometry x="0" y="0" width="410" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_content" value="&lt;b&gt;4. interview_difficulty&lt;/b&gt; (interview_blueprints.difficulty)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• easy, medium, hard (Independent from JD seniority)&lt;br/&gt;&lt;b&gt;5. interview_status&lt;/b&gt; (interview_sessions.status)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• &lt;font color=&quot;#1a73e8&quot;&gt;created&lt;/font&gt; &lt;i style=&quot;color:#666;&quot;&gt;(DEFAULT)&lt;/i&gt;, in_progress, completed,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;interrupted, terminated_early, failed&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Crow's Foot Cardinality Guide:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;||&lt;/b&gt; &lt;b&gt;Mandatory One (1):&lt;/b&gt; Referenced PK (e.g. accounts.id)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;O|&lt;/b&gt; &lt;b&gt;Zero or One (0..1):&lt;/b&gt; Nullable PK ref or 1:1 report&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&amp;gt;O&lt;/b&gt; &lt;b&gt;Zero to Many (0..*):&lt;/b&gt; Referencing child table (FK)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Solid Edge:&lt;/b&gt; Mandatory relationship (NOT NULL FK)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Dashed Edge:&lt;/b&gt; Optional relationship (Nullable FK)&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Column Badges:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;PK&lt;/b&gt; = Primary Key&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;FK&lt;/b&gt; = Foreign Key&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;UQ&lt;/b&gt; = Unique Constraint&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;NN&lt;/b&gt; = NOT NULL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="legend_box">
          <mxGeometry x="0" y="32" width="410" height="360" as="geometry" />
        </mxCell>
