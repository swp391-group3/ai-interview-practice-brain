  "cards": [
    {
      "dot": "emerald",
      "title": "Domain Trust & Flow",
      "items": [
        "Service.Extract orchestrates pre-validation (100–20,000 runes), provider extraction, candidate validation, and retries.",
        "Deterministic candidate validation enforces enums, trims values, and rejects conflicting duplicate skill metadata.",
        "StructuredJD represents the final immutable, trusted domain contract terminating KAN-18."
      ]
    },
    {
      "dot": "rose",
      "title": "Retry Budget & Errors",
      "items": [
        "Shared retry budget: LLM_MAX_RETRIES = 0 or 1 (maximum 2 provider attempts with 100ms backoff).",
        "Provider HTTPError implements RetryableFailure (429, 500, 502, 503, 504); service stays HTTP-agnostic.",
        "AppError codes: INVALID_JD_INPUT, JD_TOO_SHORT, EXTRACTION_FAILED, INVALID_EXTRACTION_OUTPUT."
      ]
    },
    {
      "dot": "cyan",
      "title": "Configuration & Scope",
      "items": [
        "Configured via config.Config (.env.example): provider=openai_compatible, endpoint=Gemini, model=gemini-3.1-flash-lite.",
        "Verified testing evidence: unit suites (service_test, openai_test) and real Gemini smoke test PASS in ~1.46s.",
        "Explicitly out of scope: REST API / DB persistence (KAN-19), PDF parsing (KAN-44), and Blueprint generation."
      ]
    }
  ]
