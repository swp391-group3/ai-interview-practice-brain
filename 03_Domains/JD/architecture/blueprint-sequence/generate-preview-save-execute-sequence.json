  "cards": [
    {
      "dot": "emerald",
      "title": "Decoupled Generation & Validation",
      "items": [
        "LLM acts as semantic planner proposing candidate assessment objectives",
        "Deterministic validator enforces schema, budgets, and policy constraints",
        "Validation failure rejects candidate plan without destroying previously saved blueprint"
      ]
    },
    {
      "dot": "amber",
      "title": "Reusable Blueprint Choices",
      "items": [
        "Candidate can adjust configuration and regenerate the blueprint",
        "Candidate can save and leave; the Blueprint remains reusable across practice sessions",
        "Starting an interview does not consume or destroy the reusable blueprint"
      ]
    },
    {
      "dot": "rose",
      "title": "Immutable Snapshot vs. Adaptive Turns",
      "items": [
        "Session creation freezes immutable blueprint_snapshot for tamper-proof evaluation",
        "Blueprint specifies WHAT to assess; it does NOT pre-generate fixed question wording",
        "Runtime orchestrator formulates dynamic questions and context-sensitive follow-ups"
      ]
    }
  ]
