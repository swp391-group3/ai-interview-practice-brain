        <!-- POSTGRESQL ENUMS: GROUP 1 (ACCOUNTS & JD) -->
        <mxCell id="enums_group1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="510" y="220" width="410" height="220" as="geometry" />
        </mxCell>
        <mxCell id="enums_g1_title" value="&lt;b&gt;POSTGRESQL ENUMS: AUTH &amp;amp; JD DOMAINS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#adb5bd;fontColor=#212529;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="enums_group1">
          <mxGeometry x="0" y="0" width="410" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enums_g1_content" value="&lt;b&gt;1. account_role&lt;/b&gt; (accounts.role)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• &lt;font color=&quot;#1a73e8&quot;&gt;participant&lt;/font&gt; &lt;i style=&quot;color:#666;&quot;&gt;(DEFAULT)&lt;/i&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;• &lt;font color=&quot;#1a73e8&quot;&gt;jury&lt;/font&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;• &lt;font color=&quot;#1a73e8&quot;&gt;admin&lt;/font&gt;&lt;br/&gt;&lt;b&gt;2. seniority_level&lt;/b&gt; (job_descriptions.seniority_level)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• intern, junior, mid, senior, lead&lt;br/&gt;&lt;b&gt;3. jd_status&lt;/b&gt; (job_descriptions.status)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• &lt;font color=&quot;#1a73e8&quot;&gt;uploaded&lt;/font&gt; &lt;i style=&quot;color:#666;&quot;&gt;(DEFAULT)&lt;/i&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;• parsing, parsed, customized, locked, failed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="enums_group1">
          <mxGeometry x="0" y="32" width="410" height="180" as="geometry" />
        </mxCell>
        <!-- SCHEMA CONSTRAINTS & METADATA -->
        <mxCell id="metadata_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="1040" width="380" height="340" as="geometry" />
        </mxCell>
        <mxCell id="meta_title" value="&lt;b&gt;SCHEMA INVARIANTS &amp;amp; EXTENSIONS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#adb5bd;fontColor=#212529;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="metadata_box">
          <mxGeometry x="0" y="0" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="meta_content" value="&lt;b&gt;PostgreSQL Extension:&lt;/b&gt;&lt;br/&gt;• CREATE EXTENSION IF NOT EXISTS &quot;uuid-ossp&quot;&lt;br/&gt;&lt;b&gt;Primary Keys &amp;amp; Types:&lt;/b&gt;&lt;br/&gt;• All 9 tables use &lt;b&gt;id uuid PRIMARY KEY DEFAULT uuid_generate_v4()&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Foreign Key Action Behavior:&lt;/b&gt;&lt;br/&gt;• &lt;font color=&quot;#b71c1c&quot;&gt;&lt;b&gt;ON DELETE CASCADE&lt;/b&gt;&lt;/font&gt; (7 FKs):&lt;br/&gt;&amp;nbsp;&amp;nbsp;- skills → technical_domains&lt;br/&gt;&amp;nbsp;&amp;nbsp;- job_descriptions → accounts&lt;br/&gt;&amp;nbsp;&amp;nbsp;- job_description_skills → job_descriptions, skills&lt;br/&gt;&amp;nbsp;&amp;nbsp;- interview_sessions → accounts&lt;br/&gt;&amp;nbsp;&amp;nbsp;- session_turns → interview_sessions&lt;br/&gt;&amp;nbsp;&amp;nbsp;- performance_reports → interview_sessions&lt;br/&gt;• &lt;font color=&quot;#b26a00&quot;&gt;&lt;b&gt;ON DELETE SET NULL&lt;/b&gt;&lt;/font&gt; (2 FKs, nullable):&lt;br/&gt;&amp;nbsp;&amp;nbsp;- interview_sessions.jd_id → job_descriptions&lt;br/&gt;&amp;nbsp;&amp;nbsp;- interview_sessions.avatar_id → avatar_profiles&lt;br/&gt;&lt;b&gt;Review History:&lt;/b&gt;&lt;br/&gt;• PR #7 by lunarcd (Nguyễn Huỳnh Nhật Anh)&lt;br/&gt;• Reviewer akagiyuu requested changes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="metadata_box">
          <mxGeometry x="0" y="32" width="380" height="300" as="geometry" />
        </mxCell>
        <!-- POSTGRESQL ENUMS & NOTATION LEGEND -->
        <mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9aa0a6;strokeWidth=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1470" y="960" width="410" height="422" as="geometry" />
        </mxCell>
        <mxCell id="leg_title" value="&lt;b&gt;POSTGRESQL ENUMS (INTERVIEW) &amp;amp; ERD LEGEND&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#adb5bd;fontColor=#212529;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="legend_box">
          <mxGeometry x="0" y="0" width="410" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_content" value="&lt;b&gt;4. interview_status&lt;/b&gt; (interview_sessions.status)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• &lt;font color=&quot;#1a73e8&quot;&gt;created&lt;/font&gt; &lt;i style=&quot;color:#666;&quot;&gt;(DEFAULT)&lt;/i&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;• in_progress, completed, interrupted,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;terminated_early, failed&lt;br/&gt;&lt;b&gt;5. interview_difficulty&lt;/b&gt; (interview_sessions.difficulty)&lt;br/&gt;&amp;nbsp;&amp;nbsp;• easy, medium, hard&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;ERD Crow's Foot Notation (Strict SQL Derived):&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;||&lt;/b&gt; &lt;b&gt;Mandatory One (1):&lt;/b&gt; Referenced PK (e.g. accounts.id)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;O|&lt;/b&gt; &lt;b&gt;Zero or One (0..1):&lt;/b&gt; Nullable PK ref or 1:1 report&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&amp;gt;O&lt;/b&gt; &lt;b&gt;Zero to Many (0..*):&lt;/b&gt; Referencing child table (FK)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Solid Edge:&lt;/b&gt; Mandatory relationship (NOT NULL FK)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Dashed Edge:&lt;/b&gt; Optional relationship (Nullable FK)&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Column Annotations:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;PK&lt;/b&gt; = Primary Key&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;FK&lt;/b&gt; = Foreign Key&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;UQ&lt;/b&gt; = Unique Constraint&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;NN&lt;/b&gt; = NOT NULL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="legend_box">
          <mxGeometry x="0" y="32" width="410" height="380" as="geometry" />
        </mxCell>
