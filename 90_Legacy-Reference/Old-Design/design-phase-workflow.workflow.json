  "cards": [
    {
      "dot": "emerald",
      "title": "Source of Truth Hierarchy",
      "items": [
        "1. Product Requirements — functional scope, candidate UX & business baseline",
        "2. Figma — canonical visual source of truth (Landing, Dash, Room, Report)",
        "3. DESIGN.md — implementation design contract, layout rules & token system",
        "4. SKILL.md — frontend engineering rules & standard component conventions",
        "5. Code — Next.js + Tailwind + shadcn/ui + Three.js/R3F implementation",
        "Note: OpenDesign, Blender & Stitch are exploration tools, not canonical sources."
      ]
    },
    {
      "dot": "cyan",
      "title": "Today's Target & Definition of Done",
      "items": [
        "1. Both Flow A (UI) and Flow B (3D) fully operational and aligned",
        "2. Canonical Landing Page UI and 3D hero approved by leads",
        "3. 3D visual cleanly integrated into Figma Landing Page without CTA clash",
        "4. frontend/DESIGN.md available with tokens, typography, colors, and layout rules",
        "5. Definition of Success: A complete, visually coherent landing page runs locally in Next.js."
      ]
    },
    {
      "dot": "amber",
      "title": "Team Rules & Visual North Star",
      "items": [
        "No manual redraws: AI-assisted exploration → Team review → Figma → Codex",
        "Human effort focuses on taste, product decisions, review, and quality acceptance",
        "Visual Language: Bright warm-white, near-black editorial typography, generous whitespace, subtle borders",
        "Strictly avoid dark AI dashboards, purple/cyan neon glow, cyberpunk, and dense clichéd cards."
      ]
    }
